# ------------------------------------------------------------------
# Studio Neige Paris — variables d'environnement (copier vers .env.local)
# Aucune de ces variables n'est requise pour lancer le site en local.
# ------------------------------------------------------------------

# URL publique du site (utilisée pour les metadata SEO et le sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse e-mail affichée sur les pages Contact et FAQ
NEXT_PUBLIC_CONTACT_EMAIL=bonjour@studioneige.fr

# Comptes sociaux (sans le @)
NEXT_PUBLIC_INSTAGRAM_HANDLE=studioneigeparis
NEXT_PUBLIC_TIKTOK_HANDLE=studioneigeparis
NEXT_PUBLIC_PINTEREST_HANDLE=studioneigeparis

# Endpoint d'inscription newsletter (Klaviyo, Brevo, Mailchimp...).
# Laisser vide : le formulaire fonctionne alors en mode démo.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
